# ==============================================================================
# IBO TRADING SIGNALS BACKEND - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# --- APPLICATION CONFIGURATION ---
APP_ENV=development
APP_PORT=3000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DATABASE CONFIGURATION ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ibo_admin
DB_PASSWORD=ibo_secure_password_placeholder
DB_NAME=ibo_signals_db
DB_SSL=false

# --- SECURITY CONFIGURATION ---
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production
JWT_EXPIRES_IN=24h

# --- LOGGING CONFIGURATION ---
LOG_LEVEL=info
