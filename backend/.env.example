# ==============================================================================
# IBO TRADING SIGNALS BACKEND - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# --- APPLICATION CONFIGURATION ---
APP_ENV=development
APP_PORT=3000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DATABASE CONFIGURATION ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ibo_admin
DB_PASSWORD=ibo_secure_password_placeholder
DB_NAME=ibo_signals_db
DB_SSL=false

# --- SECURITY CONFIGURATION ---
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production

# ===== Payment webhook signing (server-to-server) =====
# PAYMENTS_WEBHOOK_SECRET: shared secret sent by payment providers in the
# 'x-webhook-signature' header for /payments/webhooks/:provider. MUST be set in
# production; webhook requests are rejected with 401 when it is missing.
PAYMENTS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_STRONG_WEBHOOK_SECRET

# NOWPAYMENTS_IPN_SECRET: HMAC-SHA512 IPN secret from the NowPayments dashboard.
# Required to accept NowPayments IPN callbacks; strict HMAC verification only.
NOWPAYMENTS_IPN_SECRET=CHANGE_ME_FROM_NOWPAYMENTS_DASHBOARD
JWT_EXPIRES_IN=24h

# --- LOGGING CONFIGURATION ---
LOG_LEVEL=info
