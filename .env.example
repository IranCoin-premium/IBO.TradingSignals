# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GEMINI_MODEL: Default Gemini model id used by the app and MCP tooling.
GEMINI_MODEL=gemini-3.6-flash

# SEED_ADMIN_PASSWORD: Default admin fallback credential for offline initial state seeding.
# SECURITY: Use a strong password (min 12 chars). Refuse build if matching placeholder.
SEED_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ===== Part 12 client (sample values, backend-authoritative) =====
# Backend base URL is injected via BuildConfig.BACKEND_BASE_URL (see app/build.gradle.kts)

# Firebase: place YOUR real google-services.json in app/ then set the path & uncomment below.
# The Google Services plugin (WARN when missing) injects config from this file into resources.arsc.
# Will NOT be initialised without it (app runs, FCM disabled — fail-closed, no placeholder keys).
#GOOGLE_SERVICES_JSON=app/google-services.json
